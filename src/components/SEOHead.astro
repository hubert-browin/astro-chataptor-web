---
import type { Locale } from "../i18n/config";
import {
  type AlternateUrl,
  getAlternateUrls,
  getCanonicalUrl,
  localeHreflang,
} from "../utils/i18n";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  slug: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  author?: string;
  noindex?: boolean;
  alternates?: AlternateUrl[];
}

const {
  title,
  description,
  lang,
  slug,
  image,
  imageAlt,
  type = "website",
  publishedAt,
  modifiedAt,
  author = "Chataptor",
  noindex = false,
  alternates: alternateUrls,
} = Astro.props;

const cleanDescription = description.replace(/<[^>]*>?/gm, "").trim();
const cleanImageAlt = (imageAlt || title).replace(/<[^>]*>?/gm, "").trim();

const finalImage = image || `/images/og-default-${lang}.jpg`;

const alternates = alternateUrls?.length
  ? alternateUrls
  : getAlternateUrls(slug);
const canonical = getCanonicalUrl(lang, slug);
const fullTitle = `${title}`;
const xDefaultUrl = alternates.find((a) => a.lang === "en")?.url;

const siteUrl = Astro.site
  ? new URL("/", Astro.site).toString()
  : "https://chataptor.com/";
const logoUrl = Astro.site
  ? new URL("/images/landing/logo-black.png", Astro.site).toString()
  : "https://chataptor.com/images/landing/logo-black.png";
const ogImage = new URL(finalImage, siteUrl).toString();
const sitemapUrl = new URL("/sitemap-index.xml", siteUrl).toString();

const localeMap: Record<Locale, string> = {
  en: "en_US",
  pl: "pl_PL",
  de: "de_DE",
  fr: "fr_FR",
  es: "es_ES",
  it: "it_IT",
  cs: "cs_CZ",
  sk: "sk_SK",
};

const formattedLocale = localeMap[lang] || "en_US";

const breadcrumbLabelBySegment: Record<string, string> = {
  about: "About",
  blog: "Blog",
  integrations: "Integrations",
  wordpress: "WordPress",
  shoper: "Shoper",
  legal: "Legal",
  privacy: "Privacy",
  terms: "Terms",
};

function toTitleCase(segment: string): string {
  return segment
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function buildBreadcrumbItems() {
  const segments = slug
    .replace(/^\/+|\/+$/g, "")
    .split("/")
    .filter(Boolean);
  const items = [
    {
      "@type": "ListItem",
      position: 1,
      name: "Chataptor",
      item: getCanonicalUrl(lang, ""),
    },
  ];

  let currentSlug = "";
  segments.forEach((segment, index) => {
    currentSlug = [currentSlug, segment].filter(Boolean).join("/");
    const isLast = index === segments.length - 1;

    items.push({
      "@type": "ListItem",
      position: items.length + 1,
      name: isLast
        ? title
        : breadcrumbLabelBySegment[segment] || toTitleCase(segment),
      item: getCanonicalUrl(lang, currentSlug),
    });
  });

  return items;
}

const breadcrumbItems = buildBreadcrumbItems();

let schemaPageType = "WebPage";
if (type === "article") {
  schemaPageType = "BlogPosting";
} else if (slug.includes("about")) {
  schemaPageType = "AboutPage";
} else if (slug.includes("privacy") || slug.includes("terms")) {
  schemaPageType = "WebPage";
}

const mainEntity: any = {
  "@type": schemaPageType,
  "@id": `${canonical}#webpage`,
  name: title,
  description: cleanDescription,
  url: canonical,
  inLanguage: localeHreflang[lang],
  isPartOf: {
    "@id": `${siteUrl}#website`,
  },
  publisher: {
    "@id": `${siteUrl}#organization`,
  },
  ...(breadcrumbItems.length > 1
    ? {
        breadcrumb: {
          "@id": `${canonical}#breadcrumb`,
        },
      }
    : {}),
};

if (type === "article") {
  mainEntity["headline"] = title;
  mainEntity["image"] = [ogImage];
  mainEntity["mainEntityOfPage"] = canonical;
  mainEntity["author"] = {
    "@type": author === "Chataptor" ? "Organization" : "Person",
    name: author,
  };
  if (publishedAt) {
    mainEntity["datePublished"] = publishedAt.toISOString();
  }
  mainEntity["dateModified"] = (
    modifiedAt ||
    publishedAt ||
    new Date()
  ).toISOString();
}

const schemaGraph: any[] = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    name: "Chataptor",
    description:
      "Chataptor is a free customer communication tool for live chat, shared inboxes, e-commerce, marketplace messages, mobile support, and automatic conversation translation.",
    url: siteUrl,
    publisher: {
      "@id": `${siteUrl}#organization`,
    },
  },
  mainEntity,
  {
    "@type": "Organization",
    "@id": `${siteUrl}#organization`,
    name: "Chataptor",
    url: siteUrl,
    logo: logoUrl,
  },
];

if (slug === "") {
  schemaGraph.push({
    "@type": "SoftwareApplication",
    "@id": `${siteUrl}#software`,
    name: "Chataptor",
    applicationCategory: "BusinessApplication",
    applicationSubCategory:
      "Customer communication, live chat, omnichannel inbox, e-commerce support, marketplace messaging, and automatic translation",
    operatingSystem: "Web",
    url: siteUrl,
    description:
      "Chataptor is a free customer communication tool with no message limits. It can work as a website live chat, mobile customer support app, shared inbox for multiple channels, e-commerce and marketplace messaging tool, and automatic translation system for international customer support.",
    featureList: [
      "Free website live chat",
      "Customer messages in one shared inbox",
      "Mobile customer support app",
      "E-commerce and marketplace communication",
      "Automatic conversation translation",
      "International customer support",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  });
}

if (breadcrumbItems.length > 1) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: breadcrumbItems,
  });
}
---

<title>{fullTitle}</title>
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href={sitemapUrl} />

{
  !noindex &&
    alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
    ))
}
{
  !noindex && xDefaultUrl && (
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
  )
}

<meta property="og:site_name" content="Chataptor" />
<meta property="og:title" content={title} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" content={cleanImageAlt} />
<meta property="og:locale" content={formattedLocale} />
{
  !noindex &&
    alternates
      .filter((a) => a.lang !== lang)
      .map((alt) => (
        <meta
          property="og:locale:alternate"
          content={localeMap[alt.lang] || alt.lang}
        />
      ))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@chataptor" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={cleanImageAlt} />

{
  type === "article" && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )
}
{
  type === "article" && (modifiedAt || publishedAt) && (
    <meta
      property="article:modified_time"
      content={(modifiedAt || publishedAt)?.toISOString()}
    />
  )
}

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": schemaGraph,
  })}
/>
