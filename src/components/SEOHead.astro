---
import { defaultLocale, localeHrefLang, type Locale } from '../i18n/config';
import {
  ensureTrailingSlash,
  getAlternateUrls,
  getCanonicalUrl,
  getXDefaultUrl,
  type AlternateUrl,
} from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  slug: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  alternateUrls?: AlternateUrl[];
}

const {
  title,
  description,
  lang,
  slug,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  author = 'Chataptor',
  noindex = false,
  canonicalUrl,
  alternateUrls,
} = Astro.props;

const siteUrl = new URL('/', Astro.site || 'https://chataptor.com').toString();
const cleanDescription = description.replace(/<[^>]*>?/gm, '').trim();
const finalImage = image || `/images/og-default-${lang}.jpg`;
const ogImage = new URL(finalImage, siteUrl).toString();
const canonical = canonicalUrl
  ? ensureTrailingSlash(canonicalUrl)
  : getCanonicalUrl(lang, slug);
const alternates = (alternateUrls?.length ? alternateUrls : getAlternateUrls(slug)).map((alt) => ({
  ...alt,
  hreflang: alt.hreflang || localeHrefLang[alt.lang],
  url: ensureTrailingSlash(alt.url),
}));
const xDefaultUrl =
  alternates.find((alt) => alt.lang === defaultLocale)?.url || getXDefaultUrl(slug);
const fullTitle = title.toLowerCase().includes('chataptor') ? title : `${title} | Chataptor`;

const logoUrl = new URL('/images/landing/logo-black.png', siteUrl).toString();

const ogLocaleMap: Record<Locale, string> = {
  en: 'en_US',
  pl: 'pl_PL',
  de: 'de_DE',
  fr: 'fr_FR',
  es: 'es_ES',
  it: 'it_IT',
  cs: 'cs_CZ',
  sk: 'sk_SK',
};

const formattedLocale = ogLocaleMap[lang] || 'en_US';
const dateModified = updatedAt || publishedAt;
const isChataptorAuthor = author.toLowerCase().includes('chataptor');

let schemaPageType = 'WebPage';
if (slug.includes('about')) {
  schemaPageType = 'AboutPage';
}

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'Chataptor',
  url: siteUrl,
  logo: logoUrl,
  sameAs: [],
};

const mainEntity: any =
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonical}#article`,
        headline: title,
        name: title,
        description: cleanDescription,
        url: canonical,
        inLanguage: localeHrefLang[lang],
        image: ogImage,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': `${canonical}#webpage`,
        },
        author: {
          '@type': isChataptorAuthor ? 'Organization' : 'Person',
          name: author,
        },
        publisher: {
          '@id': `${siteUrl}#organization`,
        },
      }
    : {
        '@type': schemaPageType,
        '@id': `${canonical}#webpage`,
        name: title,
        description: cleanDescription,
        url: canonical,
        inLanguage: localeHrefLang[lang],
        publisher: {
          '@id': `${siteUrl}#organization`,
        },
      };

if (type === 'article' && publishedAt) {
  mainEntity.datePublished = publishedAt.toISOString();
}

if (dateModified) {
  mainEntity.dateModified = dateModified.toISOString();
}

const schemaGraph: any[] = [mainEntity, organization];

if (slug === '') {
  schemaGraph.push({
    '@type': 'SoftwareApplication',
    '@id': `${siteUrl}#software`,
    name: 'Chataptor',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: siteUrl,
    provider: {
      '@id': `${siteUrl}#organization`,
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  });
}
---

<title>{fullTitle}</title>
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonical} />

{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<meta property="og:site_name" content="Chataptor" />
<meta property="og:title" content={title} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={formattedLocale} />
{alternates
  .filter((alt) => alt.lang !== lang)
  .map((alt) => (
    <meta property="og:locale:alternate" content={ogLocaleMap[alt.lang] || alt.hreflang} />
  ))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@chataptor" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={ogImage} />

{type === 'article' && publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{type === 'article' && dateModified && (
  <meta property="article:modified_time" content={dateModified.toISOString()} />
)}

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': schemaGraph,
  })}
/>
