---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogUI } from '../../../i18n/blog';
import { locales, type Locale } from '../../../i18n/config';
import { getBlogPostAlternateUrls } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts
    .map((post) => {
      // post.slug: "en/live-chat-translation-real-time" / "de/poradnik/seo"
      const fullSlug = post.slug ?? '';
      const parts = fullSlug.split('/');

      const lang = parts[0];
      const slug = parts.slice(1).join('/');

      // odfiltruj rzeczy bez prefiksu języka / błędne
      if (!lang || !slug) return null;
      if (!locales.includes(lang as any)) return null;

      return {
        params: { lang, slug },
        props: { post },
      };
    })
    .filter(Boolean);
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const { post } = Astro.props;
const allPosts = await getCollection('blog');
const alternates = getBlogPostAlternateUrls(post, allPosts);

const { Content, headings } = await post.render();
const ui = getBlogUI(lang as any);
const backLabel = ui.backToBlog.replace(/^[\s←]+/, '').trim();

// Formatowanie daty
const formattedDate = new Intl.DateTimeFormat(lang, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.publishedAt);

// Obliczanie czasu czytania
const rawTextForCount = (post.body ?? post.data.description ?? '').toString();
const wordCount = rawTextForCount.trim().length
  ? rawTextForCount.trim().split(/\s+/g).filter(Boolean).length
  : 0;

const readTime = Math.max(1, Math.ceil(wordCount / 200));

// Adresy URL do Social Share
const currentUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `https://chataptor.com${Astro.url.pathname}`;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(post.data.title);
---

{/* PRZEKAZUJEMY PEŁNE METADANE DO BASELAYOUT I SEOHEAD */}
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  slug={`blog/${slug}`}
  type="article"
  publishedAt={post.data.publishedAt}
  modifiedAt={post.data.updatedAt}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  alternates={alternates}
>
  <!-- Postęp czytania (Pasek na górze) -->
  <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-emerald-500 z-[100] w-0 transition-all duration-100 ease-out"></div>

  <article class="bg-white min-h-screen pb-20">

    <header class="relative pt-28 md:pt-36 pb-12 md:pb-16 px-4 md:px-6 overflow-hidden bg-gradient-to-b from-zinc-50/80 via-white to-white">
      <div class="max-w-7xl mx-auto">
        <a href={`/${lang}/blog/`} class="inline-flex items-center gap-2 text-sm font-bold text-zinc-500 hover:text-zinc-900 transition-colors mb-8 group">
          <span class="w-9 h-9 rounded-full bg-white ring-1 ring-zinc-200 flex items-center justify-center group-hover:ring-zinc-900 transition-all" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5"></path>
              <path d="m12 19-7-7 7-7"></path>
            </svg>
          </span>
          {backLabel}
        </a>

        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map((tag: unknown) => (
            <span class="px-3 py-1 bg-white ring-1 ring-zinc-200 rounded-full text-[11px] font-bold text-emerald-700 uppercase tracking-wider shadow-sm">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="w-full text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-extrabold text-zinc-900 tracking-tight leading-[1.05] mb-6">
          {post.data.title}
        </h1>

        <p class="w-full text-lg md:text-xl text-zinc-500 leading-relaxed">
          {post.data.description}
        </p>

        <div class="mt-10 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-6 xl:gap-8 items-stretch max-w-6xl">
          {post.data.image && (
            <div class="aspect-[21/9] rounded-[1.5rem] md:rounded-[2rem] overflow-hidden bg-white shadow-xl shadow-zinc-200/60 ring-1 ring-black/5 relative">
              <img
                src={post.data.image}
                alt={post.data.imageAlt || post.data.title}
                class="absolute inset-0 w-full h-full object-contain"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-[1.5rem] md:rounded-[2rem] pointer-events-none"></div>
            </div>
          )}

          <div class="rounded-[1.5rem] md:rounded-[2rem] border border-zinc-100 bg-zinc-50/70 p-5 md:p-6 text-sm text-zinc-500 shadow-sm ring-1 ring-white/80 flex flex-col justify-between gap-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-zinc-500 font-bold ring-1 ring-zinc-200 shadow-sm">
                {post.data.author.charAt(0)}
              </div>
              <div>
                <div class="font-bold text-zinc-900">{post.data.author}</div>
                <div class="text-xs">{ui.post.authorLabel}</div>
              </div>
            </div>

            <div class="grid grid-cols-2 xl:grid-cols-1 gap-5">
              <div class="flex flex-col">
                <span class="font-bold text-zinc-900">{formattedDate}</span>
                <span class="text-xs">{ui.card.published}</span>
              </div>
              <div class="flex flex-col">
                <span class="font-bold text-zinc-900">
                  {readTime} {ui.post.minutesShort}
                </span>
                <span class="text-xs">{ui.post.readTimeLabel}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 xl:grid-cols-[220px_minmax(0,800px)] gap-10 xl:gap-14 justify-center items-start border-t border-zinc-100 pt-10 md:pt-14">

        {headings && headings.length > 0 && (
          <aside class="hidden xl:block">
            <nav aria-label={ui.post.tocTitle} class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-auto pr-2">
              <h2 class="text-xs font-bold text-zinc-400 uppercase tracking-widest mb-4">
                {ui.post.tocTitle}
              </h2>
              <ul class="space-y-1 border-l border-zinc-100">
                {headings.filter((h: any) => h.depth > 1 && h.depth <= 3).map((heading: any) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class={`block py-1.5 text-xs leading-snug text-zinc-500 hover:text-emerald-600 hover:border-l hover:border-emerald-500 -ml-px transition-all ${heading.depth === 3 ? 'pl-6' : 'pl-3 font-semibold'}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        <div class="min-w-0 xl:col-start-2">
          <div class="prose prose-zinc prose-lg max-w-none
            prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-zinc-900
            prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5 prose-h2:leading-tight
            prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:leading-tight
            prose-p:text-zinc-600 prose-p:leading-8
            prose-strong:text-zinc-900
            prose-a:text-emerald-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:text-emerald-500 hover:prose-a:underline
            prose-img:rounded-3xl prose-img:shadow-xl prose-img:my-12 prose-img:ring-1 prose-img:ring-black/5
            prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-zinc-50 prose-blockquote:py-4 prose-blockquote:px-6 md:prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:not-italic prose-blockquote:font-medium prose-blockquote:text-zinc-800
            prose-code:bg-zinc-100 prose-code:text-emerald-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
            prose-li:marker:text-emerald-500">
            <Content />
          </div>

      {/* --- SEKCJA SHARE & AUTHOR (Prawdziwe Linki HTML) --- */}
      <div class="mt-20 pt-10 border-t border-zinc-100">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-zinc-900">{ui.post.shareLabel}</span>
            <div class="flex gap-2">
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-blue-50 text-zinc-400 hover:text-blue-600 flex items-center justify-center transition-colors"
                title={ui.post.shareFacebook}
                aria-label={ui.post.shareFacebook}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>

              <a
                href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-sky-50 text-zinc-400 hover:text-sky-500 flex items-center justify-center transition-colors"
                title={ui.post.shareTwitter}
                aria-label={ui.post.shareTwitter}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
              </a>

              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-blue-50 text-zinc-400 hover:text-blue-700 flex items-center justify-center transition-colors"
                title={ui.post.shareLinkedIn}
                aria-label={ui.post.shareLinkedIn}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>

          <a href={`/${lang}/blog/`} class="text-sm font-bold text-zinc-500 hover:text-emerald-600 transition-colors">
            {ui.post.allPostsLink}
          </a>
        </div>
      </div>

        </div>
      </div>
    </div>

  </article>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const progressBar = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const scrollPercent = (scrollTop / docHeight) * 100;
      if (progressBar) progressBar.style.width = scrollPercent + '%';
    });
  });
</script>
