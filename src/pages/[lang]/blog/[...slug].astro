---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBlogUI } from "../../../i18n/blog";
import { locales, type Locale } from "../../../i18n/config";
import { getBlogPostAlternateUrls } from "../../../utils/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts
    .map((post) => {
      const fullSlug = post.slug ?? "";
      const parts = fullSlug.split("/");

      const lang = parts[0];
      const slug = parts.slice(1).join("/");

      if (!lang || !slug) return null;
      if (!locales.includes(lang as any)) return null;

      return {
        params: { lang, slug },
        props: { post },
      };
    })
    .filter(Boolean);
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const { post } = Astro.props;
const allPosts = await getCollection("blog");
const alternates = getBlogPostAlternateUrls(post, allPosts);

const { Content, headings } = await post.render();
const ui = getBlogUI(lang as any);
const backLabel = ui.backToBlog.replace(/^[\sâ†]+/, "").trim();

const formattedDate = new Intl.DateTimeFormat(lang, {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.publishedAt);

const rawTextForCount = (post.body ?? post.data.description ?? "").toString();
const wordCount = rawTextForCount.trim().length
  ? rawTextForCount.trim().split(/\s+/g).filter(Boolean).length
  : 0;

const readTime = Math.max(1, Math.ceil(wordCount / 200));
const tocHeadings = headings.filter(
  (heading: any) => heading.depth > 1 && heading.depth <= 3,
);
const visibleTags = post.data.tags.slice(0, 4);
const authorInitial = post.data.author.trim().charAt(0).toUpperCase() || "C";
const publishedIso = post.data.publishedAt.toISOString().split("T")[0];

const currentUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : `https://chataptor.com${Astro.url.pathname}`;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(post.data.title);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  slug={`blog/${slug}`}
  type="article"
  publishedAt={post.data.publishedAt}
  modifiedAt={post.data.updatedAt}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  alternates={alternates}
>
  <div
    id="progress-bar"
    class="fixed top-0 left-0 h-1 bg-emerald-500 z-[100] w-0 transition-all duration-100 ease-out"
  >
  </div>

  <article class="bg-white min-h-screen pb-20">
    <header
      class="relative px-4 md:px-6 pt-24 md:pt-32 pb-8 md:pb-10 overflow-hidden bg-gradient-to-b from-zinc-50 via-white to-white"
    >
      <div class="max-w-[1180px] mx-auto">
        <a
          href={`/${lang}/blog/`}
          class="inline-flex items-center gap-2 text-sm font-bold text-zinc-500 hover:text-zinc-900 transition-colors mb-6 md:mb-8 group"
        >
          <span
            class="w-9 h-9 rounded-full bg-white ring-1 ring-zinc-200 flex items-center justify-center group-hover:ring-zinc-900 transition-all"
            aria-hidden="true"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M19 12H5"></path>
              <path d="m12 19-7-7 7-7"></path>
            </svg>
          </span>
          {backLabel}
        </a>

        <div
          class={`grid grid-cols-1 gap-8 lg:gap-12 ${post.data.image ? "lg:grid-cols-[minmax(0,1fr)_minmax(320px,500px)] lg:items-center" : ""}`}
        >
          <div class="min-w-0">
            <div
              class="flex gap-2 overflow-x-auto pb-1 md:flex-wrap md:overflow-visible md:pb-0"
            >
              {
                visibleTags.map((tag: unknown) => (
                  <span class="shrink-0 px-3 py-1 bg-white ring-1 ring-zinc-200 rounded-full text-[11px] font-bold text-emerald-700 uppercase tracking-wider shadow-sm">
                    {tag}
                  </span>
                ))
              }
            </div>

            <h1
              class="mt-5 max-w-4xl text-[2.55rem] sm:text-5xl lg:text-[5.1rem] font-extrabold text-zinc-900 tracking-tight leading-[1.03] text-balance"
            >
              {post.data.title}
            </h1>

            <p
              class="mt-5 max-w-3xl text-base md:text-xl text-zinc-500 leading-relaxed"
            >
              {post.data.description}
            </p>

            <div
              class="mt-6 flex flex-wrap items-center gap-2.5 text-sm text-zinc-600"
            >
              <div
                class="inline-flex max-w-full items-center gap-3 rounded-full bg-white px-2.5 py-2 pr-4 ring-1 ring-zinc-200 shadow-sm"
              >
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-900 text-xs font-bold text-white"
                >
                  {authorInitial}
                </span>
                <span class="min-w-0 truncate font-bold text-zinc-900"
                  >{post.data.author}</span
                >
              </div>

              <time
                datetime={publishedIso}
                class="inline-flex items-center gap-2 rounded-full bg-zinc-50 px-3 py-2 font-semibold text-zinc-700 ring-1 ring-zinc-200/70"
              >
                <svg
                  class="h-4 w-4 text-zinc-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M8 2v4"></path>
                  <path d="M16 2v4"></path>
                  <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                  <path d="M3 10h18"></path>
                </svg>
                {formattedDate}
              </time>

              <span
                class="inline-flex items-center gap-2 rounded-full bg-zinc-50 px-3 py-2 font-semibold text-zinc-700 ring-1 ring-zinc-200/70"
              >
                <svg
                  class="h-4 w-4 text-zinc-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
                {readTime}
                {ui.post.minutesShort}
              </span>
            </div>
          </div>

          {
            post.data.image && (
              <figure class="relative overflow-hidden rounded-2xl bg-white shadow-xl shadow-zinc-200/70 ring-1 ring-black/5">
                <div class="aspect-[16/10]">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    class="absolute inset-0 w-full h-full object-contain"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-2xl pointer-events-none" />
              </figure>
            )
          }
        </div>
      </div>
    </header>

    {
      tocHeadings.length > 0 && (
        <div class="xl:hidden sticky top-[4.75rem] md:top-[5.5rem] z-40 border-y border-zinc-100 bg-white/95 backdrop-blur-xl">
          <nav
            aria-label={ui.post.tocTitle}
            class="max-w-[1180px] mx-auto px-4 md:px-6"
          >
            <div class="article-mobile-toc flex items-center gap-2 overflow-x-auto py-3">
              <span class="shrink-0 text-[10px] font-bold text-zinc-400 uppercase tracking-widest">
                {ui.post.tocTitle}
              </span>
              {tocHeadings.map((heading: any) => (
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class="toc-link shrink-0 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-xs font-bold leading-none text-zinc-500 transition-colors hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700"
                >
                  {heading.text}
                </a>
              ))}
            </div>
          </nav>
        </div>
      )
    }

    <div class="max-w-[1180px] mx-auto px-4 md:px-6">
      <div
        class={`grid grid-cols-1 gap-8 xl:gap-14 justify-center items-start border-t border-zinc-100 pt-8 md:pt-12 ${tocHeadings.length > 0 ? "xl:grid-cols-[240px_minmax(0,780px)]" : "xl:grid-cols-[minmax(0,780px)]"}`}
      >
        {
          tocHeadings.length > 0 && (
            <aside class="hidden xl:block xl:sticky xl:top-28 self-start">
              <nav
                aria-label={ui.post.tocTitle}
                class="desktop-toc max-h-[calc(100vh-8rem)] overflow-auto pr-3"
              >
                <h2 class="text-xs font-bold text-zinc-400 uppercase tracking-widest mb-4">
                  {ui.post.tocTitle}
                </h2>
                <ul class="space-y-1 border-l border-zinc-100">
                  {tocHeadings.map((heading: any) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        data-toc-link
                        class={`toc-link block border-l border-transparent py-1.5 text-xs leading-snug text-zinc-500 -ml-px transition-colors hover:border-emerald-500 hover:text-emerald-700 ${heading.depth === 3 ? "pl-6" : "pl-3 font-semibold"}`}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )
        }

        <div
          class={`article-copy min-w-0 ${tocHeadings.length > 0 ? "xl:col-start-2" : ""}`}
        >
          <div
            class="prose prose-zinc prose-base md:prose-lg max-w-none
            prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-zinc-900
            prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:mt-12 md:prose-h2:mt-14 prose-h2:mb-5 prose-h2:leading-tight
            prose-h3:text-xl md:prose-h3:text-2xl prose-h3:mt-9 md:prose-h3:mt-10 prose-h3:mb-4 prose-h3:leading-tight
            prose-p:text-zinc-600 prose-p:leading-7 md:prose-p:leading-8
            prose-strong:text-zinc-900
            prose-a:text-emerald-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:text-emerald-500 hover:prose-a:underline
            prose-img:rounded-2xl prose-img:shadow-xl prose-img:my-10 md:prose-img:my-12 prose-img:ring-1 prose-img:ring-black/5
            prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-zinc-50 prose-blockquote:py-4 prose-blockquote:px-5 md:prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:not-italic prose-blockquote:font-medium prose-blockquote:text-zinc-800
            prose-code:bg-zinc-100 prose-code:text-emerald-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
            prose-li:marker:text-emerald-500"
          >
            <Content />
          </div>

          <div class="mt-16 md:mt-20 pt-8 md:pt-10 border-t border-zinc-100">
            <div
              class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
            >
              <div class="flex flex-wrap items-center gap-4">
                <span class="text-sm font-bold text-zinc-900"
                  >{ui.post.shareLabel}</span
                >
                <div class="flex gap-2">
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-blue-50 text-zinc-400 hover:text-blue-600 flex items-center justify-center transition-colors"
                    title={ui.post.shareFacebook}
                    aria-label={ui.post.shareFacebook}
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                      ><path
                        d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                      ></path></svg
                    >
                  </a>

                  <a
                    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-sky-50 text-zinc-400 hover:text-sky-500 flex items-center justify-center transition-colors"
                    title={ui.post.shareTwitter}
                    aria-label={ui.post.shareTwitter}
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                      ><path
                        d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                      ></path></svg
                    >
                  </a>

                  <a
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="w-10 h-10 rounded-full bg-zinc-50 hover:bg-blue-50 text-zinc-400 hover:text-blue-700 flex items-center justify-center transition-colors"
                    title={ui.post.shareLinkedIn}
                    aria-label={ui.post.shareLinkedIn}
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                      ><path
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                      ></path></svg
                    >
                  </a>
                </div>
              </div>

              <a
                href={`/${lang}/blog/`}
                class="text-sm font-bold text-zinc-500 hover:text-emerald-600 transition-colors"
              >
                {ui.post.allPostsLink}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-mobile-toc {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .article-mobile-toc::-webkit-scrollbar {
    display: none;
  }

  .toc-link.is-active {
    border-color: #10b981;
    background: #ecfdf5;
    color: #047857;
  }

  .desktop-toc .toc-link.is-active {
    background: transparent;
  }

  .article-copy :global(.prose > p:first-child) {
    color: #3f3f46;
    font-size: 1.08em;
    line-height: 1.8;
  }

  .article-copy :global(.prose h2),
  .article-copy :global(.prose h3) {
    scroll-margin-top: 9rem;
  }

  @media (min-width: 1280px) {
    .article-copy :global(.prose h2),
    .article-copy :global(.prose h3) {
      scroll-margin-top: 7rem;
    }
  }
</style>

<script>
  let articleChromePageKey = "";

  const setupArticleChrome = () => {
    const pageKey = window.location.pathname;
    if (articleChromePageKey === pageKey) return;
    articleChromePageKey = pageKey;

    const progressBar = document.getElementById("progress-bar");
    const updateProgress = () => {
      const scrollTop = window.scrollY;
      const docHeight = Math.max(
        1,
        document.body.scrollHeight - window.innerHeight,
      );
      const scrollPercent = (scrollTop / docHeight) * 100;
      if (progressBar) progressBar.style.width = scrollPercent + "%";
    };

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));
    const tocTargets = [];

    tocLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const target = href
        ? document.getElementById(href.replace("#", ""))
        : null;
      if (target) tocTargets.push(target);
    });

    const setActiveTocLink = (id) => {
      tocLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === `#${id}`;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    if (tocTargets.length > 0) {
      setActiveTocLink(tocTargets[0].id);

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntry = entries
              .filter((entry) => entry.isIntersecting)
              .sort(
                (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
              )[0];

            if (visibleEntry?.target?.id) {
              setActiveTocLink(visibleEntry.target.id);
            }
          },
          {
            rootMargin: "-25% 0px -62% 0px",
            threshold: [0, 1],
          },
        );

        tocTargets.forEach((target) => observer.observe(target));
      }
    }
  };

  document.addEventListener("astro:page-load", setupArticleChrome);

  if (document.readyState !== "loading") {
    setupArticleChrome();
  } else {
    document.addEventListener("DOMContentLoaded", setupArticleChrome, {
      once: true,
    });
  }
</script>
