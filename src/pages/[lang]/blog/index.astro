---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../../i18n/config';
import { getBlogUI } from '../../../i18n/blog';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const ui = getBlogUI(lang);

const searchCopy: Record<Locale, {
  label: string;
  placeholder: string;
  kicker: string;
  allPosts: string;
  postsLabel: string;
  noResultsTitle: string;
  noResultsText: string;
}> = {
  pl: {
    label: 'Szukaj wpisów',
    placeholder: 'Szukaj po tytule, temacie lub tagu',
    kicker: 'Biblioteka',
    allPosts: 'Wszystkie wpisy',
    postsLabel: 'wpisy',
    noResultsTitle: 'Brak pasujących wpisów',
    noResultsText: 'Spróbuj innej frazy albo usuń filtr wyszukiwania.',
  },
  en: {
    label: 'Search posts',
    placeholder: 'Search by title, topic, or tag',
    kicker: 'Library',
    allPosts: 'All posts',
    postsLabel: 'posts',
    noResultsTitle: 'No matching posts',
    noResultsText: 'Try another phrase or clear the search filter.',
  },
  de: {
    label: 'Beiträge suchen',
    placeholder: 'Nach Titel, Thema oder Tag suchen',
    kicker: 'Bibliothek',
    allPosts: 'Alle Beiträge',
    postsLabel: 'Beiträge',
    noResultsTitle: 'Keine passenden Beiträge',
    noResultsText: 'Versuchen Sie eine andere Suchphrase oder löschen Sie den Filter.',
  },
  fr: {
    label: 'Rechercher des articles',
    placeholder: 'Rechercher par titre, sujet ou tag',
    kicker: 'Bibliothèque',
    allPosts: 'Tous les articles',
    postsLabel: 'articles',
    noResultsTitle: 'Aucun article trouvé',
    noResultsText: 'Essayez une autre recherche ou effacez le filtre.',
  },
  es: {
    label: 'Buscar entradas',
    placeholder: 'Busca por título, tema o etiqueta',
    kicker: 'Biblioteca',
    allPosts: 'Todas las entradas',
    postsLabel: 'entradas',
    noResultsTitle: 'No hay resultados',
    noResultsText: 'Prueba otra frase o borra el filtro de búsqueda.',
  },
  it: {
    label: 'Cerca articoli',
    placeholder: 'Cerca per titolo, tema o tag',
    kicker: 'Biblioteca',
    allPosts: 'Tutti gli articoli',
    postsLabel: 'articoli',
    noResultsTitle: 'Nessun articolo trovato',
    noResultsText: 'Prova un’altra ricerca o rimuovi il filtro.',
  },
  cs: {
    label: 'Hledat články',
    placeholder: 'Hledejte podle názvu, tématu nebo tagu',
    kicker: 'Knihovna',
    allPosts: 'Všechny články',
    postsLabel: 'články',
    noResultsTitle: 'Žádné odpovídající články',
    noResultsText: 'Zkuste jiný výraz nebo zrušte filtr hledání.',
  },
  sk: {
    label: 'Hľadať články',
    placeholder: 'Hľadajte podľa názvu, témy alebo tagu',
    kicker: 'Knižnica',
    allPosts: 'Všetky články',
    postsLabel: 'články',
    noResultsTitle: 'Žiadne zodpovedajúce články',
    noResultsText: 'Skúste inú frázu alebo zrušte filter vyhľadávania.',
  },
};

const searchUi = searchCopy[lang] ?? searchCopy.en;

const stripLangFromSlug = (fullSlug: string, lang: string) =>
  fullSlug.startsWith(`${lang}/`) ? fullSlug.slice(lang.length + 1) : fullSlug;

const postHref = (post: any) => `/${lang}/blog/${stripLangFromSlug(post.slug, lang)}/`;

const posts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith(`${lang}/`) && data.lang === lang;
});

const sortedPosts = posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const heroPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
};

const getIsoDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const getSearchText = (post: any) =>
  [
    post.data.title,
    post.data.description,
    post.data.author,
    ...(post.data.tags ?? []),
  ].join(' ');
---

<BaseLayout
  title={`${ui.hero.title} - Chataptor`}
  description={ui.hero.subtitle}
  lang={lang}
  slug="blog"
  type="website"
>
  <main class="bg-white min-h-screen pt-28 md:pt-32 pb-24 px-4 md:px-6 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <header class="relative mb-12 md:mb-16">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[420px] bg-emerald-100/35 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(360px,420px)] gap-8 lg:gap-14 items-end">
          <div>
            <span class="inline-flex items-center rounded-full bg-zinc-50 border border-zinc-100 text-zinc-500 text-[10px] font-bold uppercase tracking-widest px-3 py-1 mb-6">
              Blog & News
            </span>
            <h1 class="text-5xl md:text-7xl font-extrabold text-zinc-900 mb-6 tracking-tight leading-[1.05] text-balance">
              {ui.hero.title}
            </h1>
            <p class="text-lg md:text-xl text-zinc-500 max-w-3xl leading-relaxed font-light text-balance">
              {ui.hero.subtitle}
            </p>
          </div>

          <div class="relative">
            <label for="blog-search" class="block text-xs font-bold uppercase tracking-widest text-zinc-400 mb-3">
              {searchUi.label}
            </label>
            <div class="relative rounded-[1.5rem] bg-zinc-50 border border-zinc-200/70 shadow-sm focus-within:bg-white focus-within:border-emerald-500 focus-within:ring-4 focus-within:ring-emerald-500/10 transition-all">
              <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35"></path>
                <circle cx="11" cy="11" r="7"></circle>
              </svg>
              <input
                id="blog-search"
                type="search"
                data-blog-search
                placeholder={searchUi.placeholder}
                class="w-full bg-transparent border-0 outline-none pl-14 pr-5 py-4 text-base text-zinc-900 placeholder:text-zinc-400"
                autocomplete="off"
              />
            </div>
            <p class="mt-3 text-xs text-zinc-400">
              <span data-blog-count>{sortedPosts.length}</span> {searchUi.postsLabel}
            </p>
          </div>
        </div>
      </header>

      {sortedPosts.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-20 bg-zinc-50 rounded-[2rem] border border-zinc-100 border-dashed">
          <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mb-4 text-zinc-300 shadow-sm ring-1 ring-zinc-100">
            <span class="text-3xl">+</span>
          </div>
          <p class="text-zinc-500 font-medium">{ui.empty}</p>
        </div>
      ) : (
        <div class="space-y-14 md:space-y-20">
          {heroPost && (
            <a
              href={postHref(heroPost)}
              data-blog-card
              data-search-text={getSearchText(heroPost)}
              class="group block"
            >
              <article class="space-y-7 md:space-y-8">
                <div class="aspect-[21/9] rounded-[2rem] md:rounded-[2.75rem] overflow-hidden bg-white shadow-2xl shadow-zinc-200/60 ring-1 ring-black/5 relative">
                  {heroPost.data.image ? (
                    <img
                      src={heroPost.data.image}
                      alt={heroPost.data.imageAlt || heroPost.data.title}
                      class="absolute inset-0 w-full h-full object-contain"
                      fetchpriority="high"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-zinc-100 w-full h-full flex items-center justify-center text-zinc-300 text-6xl font-bold opacity-30">
                      Blog
                    </div>
                  )}
                  <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-[2rem] md:rounded-[2.75rem] pointer-events-none"></div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-7 lg:gap-12 items-start">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-3 mb-5">
                      <span class="text-[10px] font-bold text-white bg-zinc-900 px-3 py-1 rounded-full shadow-md tracking-wide">
                        {ui.hero.new}
                      </span>
                      <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full ring-1 ring-emerald-100 uppercase tracking-wide">
                        {heroPost.data.tags[0] || 'Article'}
                      </span>
                      <time datetime={getIsoDate(heroPost.data.publishedAt)} class="text-xs text-zinc-400 font-medium">
                        {formatDate(heroPost.data.publishedAt)}
                      </time>
                    </div>

                    <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-zinc-900 mb-5 leading-[1.08] tracking-tight group-hover:text-emerald-700 transition-colors text-balance">
                      {heroPost.data.title}
                    </h2>

                    <p class="text-zinc-500 text-base md:text-lg leading-relaxed max-w-4xl">
                      {heroPost.data.description}
                    </p>
                  </div>

                  <div class="flex lg:flex-col items-center lg:items-end gap-4 lg:min-w-[220px]">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full bg-zinc-100 flex items-center justify-center text-xs font-bold text-zinc-500 ring-1 ring-zinc-200">
                        {heroPost.data.author.charAt(0)}
                      </div>
                      <span class="text-sm font-bold text-zinc-900 whitespace-nowrap">{heroPost.data.author}</span>
                    </div>
                    <span class="inline-flex items-center justify-center rounded-full bg-emerald-600 text-white text-sm font-bold px-5 py-3 shadow-lg shadow-emerald-600/20 group-hover:bg-emerald-500 transition-colors">
                      {ui.hero.readMore}
                      <span class="ml-2 transition-transform group-hover:translate-x-1">→</span>
                    </span>
                  </div>
                </div>
              </article>
            </a>
          )}

          {otherPosts.length > 0 && (
            <section class="border-t border-zinc-100 pt-12 md:pt-16">
              <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8 md:mb-10">
                <div>
                  <span class="block text-[10px] font-bold text-emerald-700 uppercase tracking-widest mb-2">
                    {searchUi.kicker}
                  </span>
                  <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-zinc-900">
                    {searchUi.allPosts}
                  </h2>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-14" data-blog-grid>
                {otherPosts.map((post) => (
                  <a
                    href={postHref(post)}
                    data-blog-card
                    data-search-text={getSearchText(post)}
                    class="group flex flex-col h-full hover:-translate-y-1 transition-transform duration-300"
                  >
                    <article class="flex flex-col h-full">
                      <div class="aspect-[21/9] rounded-[1.75rem] overflow-hidden bg-white mb-5 relative shadow-md ring-1 ring-black/5">
                        {post.data.image ? (
                          <img
                            src={post.data.image}
                            alt={post.data.imageAlt || post.data.title}
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 w-full h-full object-contain"
                          />
                        ) : (
                          <div class="absolute inset-0 flex items-center justify-center text-zinc-300">Blog</div>
                        )}
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
                      </div>

                      <div class="flex-1 flex flex-col">
                        <div class="flex items-center justify-between gap-3 mb-4">
                          <span class="min-w-0 truncate text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full uppercase tracking-wide ring-1 ring-emerald-100/50">
                            {post.data.tags[0] || 'Article'}
                          </span>
                          <time datetime={getIsoDate(post.data.publishedAt)} class="shrink-0 text-[11px] text-zinc-400 font-medium">
                            {formatDate(post.data.publishedAt)}
                          </time>
                        </div>

                        <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-3 leading-tight group-hover:text-emerald-700 transition-colors text-balance">
                          {post.data.title}
                        </h3>

                        <p class="text-sm text-zinc-500 line-clamp-3 leading-relaxed mb-5 flex-1">
                          {post.data.description}
                        </p>

                        <div class="flex items-center gap-2 mt-auto pt-4 border-t border-zinc-100">
                          <span class="text-xs font-bold text-zinc-400 group-hover:text-zinc-900 transition-colors flex items-center gap-1">
                            {ui.card.readMore}
                            <span class="transition-transform group-hover:translate-x-1">→</span>
                          </span>
                        </div>
                      </div>
                    </article>
                  </a>
                ))}
              </div>
            </section>
          )}

          <div data-blog-empty class="hidden border border-dashed border-zinc-200 bg-zinc-50 rounded-[2rem] py-14 px-6 text-center">
            <h2 class="text-2xl font-extrabold text-zinc-900 mb-3">{searchUi.noResultsTitle}</h2>
            <p class="text-zinc-500">{searchUi.noResultsText}</p>
          </div>
        </div>
      )}
    </div>
  </main>

  <script>
    const searchInput = document.querySelector('[data-blog-search]');
    const cards = Array.from(document.querySelectorAll('[data-blog-card]'));
    const emptyState = document.querySelector('[data-blog-empty]');
    const countEl = document.querySelector('[data-blog-count]');

    const normalize = (value: string) =>
      value
        .toLocaleLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    const updateBlogSearch = () => {
      const query = normalize(searchInput?.value ?? '').trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const haystack = normalize(card.dataset.searchText ?? '');
        const isVisible = !query || haystack.includes(query);
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      emptyState?.classList.toggle('hidden', visibleCount > 0);
      if (countEl) countEl.textContent = String(visibleCount);
    };

    searchInput?.addEventListener('input', updateBlogSearch);
    updateBlogSearch();
  </script>
</BaseLayout>
