---
import { locales, type Locale } from '../../../i18n/config';
import { getShoperPrivacy } from '../../../i18n/shoper-privacy';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getShoperPrivacy(lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  slug="legal/shoper-privacy"
>
  <main class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-12 md:py-20">
      {/* Nagłówek strony */}
      <header class="mb-12">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-zinc-900 transition-colors mb-8"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          {t.header.backToHome}
        </a>

        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white ring-1 ring-zinc-900/5 rounded-full text-[11px] font-medium text-zinc-500 mb-6 shadow-[0_2px_8px_rgba(0,0,0,0.04)]">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          {t.header.badge}
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight mb-4">
          {t.header.pageTitle}
        </h1>
        <div class="flex flex-wrap gap-4 text-sm text-zinc-500">
          <span>{t.header.effectiveDate}</span>
          <span aria-hidden="true">·</span>
          <span>{t.header.lastUpdated}</span>
          <span aria-hidden="true">·</span>
          <span>{t.header.version}</span>
        </div>
      </header>

      {/* Intro */}
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 ring-1 ring-emerald-200/50 rounded-2xl p-6 mb-12">
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
          </div>
          <div>
            <p class="text-emerald-900 font-semibold mb-1">{t.intro.title}</p>
            <p class="text-emerald-800/80 text-sm leading-relaxed">{t.intro.description}</p>
          </div>
        </div>
      </div>

      {/* Sekcje */}
      <article class="space-y-12">
        {t.sections.map((section) => (
          <section id={section.id} class="scroll-mt-24">
            <div class="flex items-start gap-4 mb-6">
              <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center shadow-sm">
                <span class="text-white font-bold text-sm">{section.number}</span>
              </div>
              <h2 class="text-xl md:text-2xl font-bold text-zinc-900 pt-1.5">{section.title}</h2>
            </div>

            <div class="pl-0 md:pl-14 space-y-5">
              {/* Paragrafy sekcji głównej */}
              {section.paragraphs?.map((p) => (
                <p class="text-zinc-700 leading-relaxed" set:html={p} />
              ))}

              {/* Listy sekcji głównej */}
              {section.lists?.map((list) => (
                <div>
                  {list.heading && <p class="font-semibold text-zinc-900 mb-2">{list.heading}</p>}
                  <ul class="list-disc pl-5 space-y-1.5 text-zinc-700">
                    {list.items.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </div>
              ))}

              {/* Tabele sekcji głównej */}
              {section.tables?.map((table) => (
                <div>
                  {table.heading && <p class="font-semibold text-zinc-900 mb-2">{table.heading}</p>}
                  <div class="overflow-x-auto bg-white rounded-xl ring-1 ring-zinc-200">
                    <table class="w-full text-sm">
                      <thead>
                        <tr class="bg-zinc-50 border-b border-zinc-100">
                          {table.headers.map((h) => (
                            <th class="text-left px-4 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                              {h}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-zinc-100">
                        {table.rows.map((row) => (
                          <tr>
                            {row.cells.map((cell) => (
                              <td class="px-4 py-3 text-zinc-700 align-top" set:html={cell} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  {table.note && <p class="text-xs text-zinc-500 mt-2 italic">{table.note}</p>}
                </div>
              ))}

              {/* Podsekcje */}
              {section.subsections?.map((sub) => (
                <div class="pt-4">
                  <h3 class="text-lg font-semibold text-zinc-900 mb-3 flex items-baseline gap-2">
                    <span class="text-emerald-700 text-sm font-bold tracking-wider">{sub.number}</span>
                    {sub.title}
                  </h3>
                  <div class="space-y-4">
                    {sub.paragraphs?.map((p) => (
                      <p class="text-zinc-700 leading-relaxed" set:html={p} />
                    ))}

                    {sub.lists?.map((list) => (
                      <div>
                        {list.heading && <p class="font-semibold text-zinc-900 mb-2">{list.heading}</p>}
                        <ul class="list-disc pl-5 space-y-1.5 text-zinc-700">
                          {list.items.map((item) => (
                            <li set:html={item} />
                          ))}
                        </ul>
                      </div>
                    ))}

                    {sub.tables?.map((table) => (
                      <div>
                        {table.heading && <p class="font-semibold text-zinc-900 mb-2">{table.heading}</p>}
                        <div class="overflow-x-auto bg-white rounded-xl ring-1 ring-zinc-200">
                          <table class="w-full text-sm">
                            <thead>
                              <tr class="bg-zinc-50 border-b border-zinc-100">
                                {table.headers.map((h) => (
                                  <th class="text-left px-4 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    {h}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-100">
                              {table.rows.map((row) => (
                                <tr>
                                  {row.cells.map((cell) => (
                                    <td class="px-4 py-3 text-zinc-700 align-top" set:html={cell} />
                                  ))}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        {table.note && <p class="text-xs text-zinc-500 mt-2 italic">{table.note}</p>}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </article>
    </div>
  </main>
</BaseLayout>
