---

<BaseLayout
  title={t.hero.pagetitle}
  description={t.hero.description}
  lang={lang}
  slug=""
  isLandingPage={true} 
>
  {/* Style lokalne dla tej strony (animacje, popovery) */}
  <style>
    /* --- NOWE ANIMACJE DLA WIZUALIZACJI HERO --- */
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    .animate-float-delayed {
      animation: float 6s ease-in-out infinite 3s;
    }
    
    @keyframes float-rotate {
      0%, 100% { transform: translateY(0px) rotate(-2deg); }
      50% { transform: translateY(-15px) rotate(1deg); }
    }
    .animate-float-rotate {
      animation: float-rotate 8s ease-in-out infinite;
    }
  </style>

  <main>
    
    <!-- HERO SECTION -->
    <section class="relative min-h-[100dvh] flex flex-col pt-24 pb-4 md:pt-0 md:pb-0 overflow-hidden">
      <div class="absolute inset-0 hero-gradient -z-10 pointer-events-none"></div>

      <!-- World Map Background -->
      <img
        src="/images/dotted_worldmap.svg"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[180%] sm:w-[140%] md:w-[95%] 2xl:w-[115%] max-w-[120rem] h-auto z-0 opacity-[0.05] md:opacity-[0.06] pointer-events-none"
        style="filter: grayscale(100%) brightness(0);"
      />

      <!-- Main Hero Wrapper - Two Columns Layout -->
      <div class="w-full h-full px-4 md:px-6 max-w-7xl mx-auto relative z-30 flex-1 flex flex-col pt-8 lg:pt-32">
        
        <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-0 flex-1 w-full">
          
          <!-- LEFT COLUMN: Content -->
          <div class="flex flex-col justify-center items-center lg:items-start w-full lg:w-[65%] text-center lg:text-left z-20">
            
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-white ring-1 ring-zinc-900/5 rounded-full text-[11px] font-medium text-zinc-500 mb-6 mx-auto lg:mx-0 shadow-[0_2px_8px_rgba(0,0,0,0.04)] hover:ring-zinc-900/10 transition-all cursor-default">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-50"></span>
              </span>
              <span class="hidden sm:inline">{t.hero.badge}</span>
              <span class="sm:hidden">{t.hero.badgeMobile}</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.2] mb-6 text-zinc-900">
              {t.hero.title1}<br class="block sm:hidden lg:block" />
              <span class="hidden sm:inline lg:hidden"><br /></span>
              <span class="text-zinc-400 mt-2 sm:mt-0 block sm:inline lg:block font-semibold">{t.hero.title2}</span>
            </h1>

            <p class="text-sm sm:text-lg lg:text-xl text-zinc-500 max-w-2xl mx-auto lg:mx-0 font-normal mb-8 leading-relaxed lg:pr-8">
              <span class="md:hidden">{t.hero.descriptionMobile}</span>
              <span class="hidden md:inline">{t.hero.description}</span>
              <br class="hidden md:block"/>
              <span class="block mt-2 md:inline md:mt-0 text-zinc-900 font-medium">{t.hero.descriptionHighlight}</span>
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5 sm:gap-4 lg:gap-6 relative w-full sm:w-auto">
              <!-- Main CTA -->
              <a href="/register" class="w-full sm:w-auto px-8 py-3.5 bg-emerald-600 text-white rounded-full text-[0.9375rem] font-semibold hover:bg-emerald-500 transition-all hover:scale-[1.02] shadow-xl shadow-emerald-600/10 active:scale-95 text-center">
                {t.hero.cta}
              </a>
              
              <!-- INLINE CONTACT QUICK ACTIONS (Hero) -->
              <div class="relative w-full sm:w-auto z-20 flex items-center justify-between px-2 sm:px-0 sm:justify-start gap-3 sm:gap-3 md:gap-4 mt-2 sm:mt-0">
                
                  <!-- Phone with copy badge on hover -->
                  <div class="relative group/copy group/btn shrink-0">
                    <a href="tel:+48695151096" class="w-14 h-14 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-white hover:bg-zinc-50 ring-1 ring-zinc-200/80 text-zinc-600 hover:text-zinc-900 transition-all shadow-sm hover:shadow hover:scale-105 active:scale-95" aria-label={t.contactPopup.tooltipCall}>
                      <svg class="w-6 h-6 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    </a>
                    <button class="copy-btn absolute -top-1.5 -right-1.5 opacity-0 pointer-events-none group-hover/copy:opacity-100 group-hover/copy:pointer-events-auto w-7 h-7 sm:w-6 sm:h-6 bg-zinc-800 text-white rounded-full flex items-center justify-center shadow-md scale-75 group-hover/copy:scale-100 transition-all z-10 cursor-pointer" data-text="+48 695 151 096" title={t.contactPopup.copyNumber}>
                      <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    </button>
                    <!-- Desktop Tooltip -->
                    <div class="absolute top-[calc(100%+10px)] left-1/2 -translate-x-1/2 opacity-0 translate-y-1 group-hover/btn:opacity-100 group-hover/btn:translate-y-0 pointer-events-none transition-all duration-200 bg-zinc-800 text-zinc-50 text-[11px] font-medium px-2.5 py-1.5 rounded-md shadow-sm whitespace-nowrap hidden sm:block z-50">
                      {t.contactPopup.tooltipCall}
                      <div class="absolute -top-[5px] left-1/2 -translate-x-1/2 border-[3px] border-transparent border-b-zinc-800"></div>
                    </div>
                  </div>
                  
                  <!-- Email with copy badge on hover -->
                  <div class="relative group/copy group/btn shrink-0">
                    <a href="mailto:contact@chataptor.com" class="w-14 h-14 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-white hover:bg-zinc-50 ring-1 ring-zinc-200/80 text-zinc-600 hover:text-zinc-900 transition-all shadow-sm hover:shadow hover:scale-105 active:scale-95" aria-label={t.contactPopup.tooltipEmail}>
                      <svg class="w-6 h-6 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </a>
                    <button class="copy-btn absolute -top-1.5 -right-1.5 opacity-0 pointer-events-none group-hover/copy:opacity-100 group-hover/copy:pointer-events-auto w-7 h-7 sm:w-6 sm:h-6 bg-zinc-800 text-white rounded-full flex items-center justify-center shadow-md scale-75 group-hover/copy:scale-100 transition-all z-10 cursor-pointer" data-text="contact@chataptor.com" title={t.contactPopup.copyEmail}>
                      <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    </button>
                    <!-- Desktop Tooltip -->
                    <div class="absolute top-[calc(100%+10px)] left-1/2 -translate-x-1/2 opacity-0 translate-y-1 group-hover/btn:opacity-100 group-hover/btn:translate-y-0 pointer-events-none transition-all duration-200 bg-zinc-800 text-zinc-50 text-[11px] font-medium px-2.5 py-1.5 rounded-md shadow-sm whitespace-nowrap hidden sm:block z-50">
                      {t.contactPopup.tooltipEmail}
                      <div class="absolute -top-[5px] left-1/2 -translate-x-1/2 border-[3px] border-transparent border-b-zinc-800"></div>
                    </div>
                  </div>

                  <!-- WhatsApp -->
                  <div class="relative group/btn shrink-0">
                    <a href="https://wa.me/48695151096" target="_blank" rel="noopener noreferrer nofollow" class="w-14 h-14 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-white hover:bg-[#25D366]/10 ring-1 ring-zinc-200/80 text-[#25D366] transition-all shadow-sm hover:shadow hover:scale-105 active:scale-95" aria-label="WhatsApp">
                      <svg class="w-6 h-6 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    </a>
                    <!-- Desktop Tooltip -->
                    <div class="absolute top-[calc(100%+10px)] left-1/2 -translate-x-1/2 opacity-0 translate-y-1 group-hover/btn:opacity-100 group-hover/btn:translate-y-0 pointer-events-none transition-all duration-200 bg-zinc-800 text-zinc-50 text-[11px] font-medium px-2.5 py-1.5 rounded-md shadow-sm whitespace-nowrap hidden sm:block z-50">
                      WhatsApp
                      <div class="absolute -top-[5px] left-1/2 -translate-x-1/2 border-[3px] border-transparent border-b-zinc-800"></div>
                    </div>
                  </div>

                  <!-- Messenger -->
                  <div class="relative group/btn shrink-0">
                    <a href="https://m.me/chataptor" target="_blank" rel="noopener noreferrer nofollow" class="w-14 h-14 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-white hover:bg-[#0084FF]/10 ring-1 ring-zinc-200/80 text-[#0084FF] transition-all shadow-sm hover:shadow hover:scale-105 active:scale-95" aria-label="Messenger">
                      <svg class="w-6 h-6 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.36 2 2 6.13 2 11.7c0 2.91 1.21 5.56 3.16 7.39.16.15.26.36.26.59V21.5c0 .63.66 1.04 1.21.75l2.67-1.4a.97.97 0 0 1 .64-.09c.68.12 1.37.19 2.06.19 5.64 0 10-4.13 10-9.7S17.64 2 12 2zm1.61 11.33l-2.07-2.2a.53.53 0 0 0-.76 0l-4.52 3.44c-.45.34-1.04-.26-.67-.7l3.85-4.57a.54.54 0 0 1 .83 0l2.07 2.2a.53.53 0 0 0 .76 0l4.52-3.45c.45-.34 1.04.26.67.7l-3.85 4.58a.54.54 0 0 1-.83 0z"/></svg>
                    </a>
                    <!-- Desktop Tooltip -->
                    <div class="absolute top-[calc(100%+10px)] left-1/2 -translate-x-1/2 opacity-0 translate-y-1 group-hover/btn:opacity-100 group-hover/btn:translate-y-0 pointer-events-none transition-all duration-200 bg-zinc-800 text-zinc-50 text-[11px] font-medium px-2.5 py-1.5 rounded-md shadow-sm whitespace-nowrap hidden sm:block z-50">
                      Messenger
                      <div class="absolute -top-[5px] left-1/2 -translate-x-1/2 border-[3px] border-transparent border-b-zinc-800"></div>
                    </div>
                  </div>

