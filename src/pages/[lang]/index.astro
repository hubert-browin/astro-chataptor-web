                    <button data-quantumchat-open class="w-14 h-14 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-zinc-900 hover:bg-black ring-1 ring-zinc-900 text-white transition-all shadow-md hover:shadow-lg hover:scale-105 active:scale-95 relative cursor-pointer" aria-label={t.contactPopup.tooltipChat}>
                      <span class="absolute top-0 right-0 sm:top-0 sm:right-0 w-3 h-3 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-500 ring-2 ring-white"></span>
                      <img src="https://i.ibb.co/8nmvGHZH/logo-black.png" alt="Chataptor" class="w-6 h-6 sm:w-5 sm:h-5 object-contain brightness-0 invert" loading="lazy" width="24" height="24" />
