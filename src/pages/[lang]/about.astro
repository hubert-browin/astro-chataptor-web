---
import { locales, type Locale } from '../../i18n/config';
import { getLanding } from '../../i18n/landing';
import { getAbout } from '../../i18n/about';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getLanding(lang); // For Pricing, Footer, Modal
const tAbout = getAbout(lang); // For About page content

// Ścieżki do zdjęć
const hubertImg = "/images/about/hubert.webp";
const marekImg = "/images/about/marek.webp";
---

<BaseLayout
  title={`${tAbout.hero.title}${tAbout.hero.highlight} | Chataptor`}
  description={tAbout.hero.subtitle}
  lang={lang}
  slug="about"
  type="website"
>
  <main class="bg-white selection:bg-emerald-500 selection:text-white overflow-x-hidden">
    
    <section class="relative pt-28 pb-16 md:pt-48 md:pb-28 w-[90%] md:w-[95%] md:max-w-[72rem] mx-auto overflow-hidden">
      <div class="absolute top-0 right-[5%] w-[1px] h-full bg-zinc-100 hidden md:block"></div>
      <div class="absolute top-0 right-[25%] w-[1px] h-full bg-zinc-100 hidden md:block"></div>
      
      <div class="relative z-10 max-w-5xl flex flex-col items-center text-center md:items-start md:text-left mx-auto md:mx-0">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[4.5rem] font-extrabold tracking-tighter text-zinc-900 leading-[1.05]">
          {tAbout.hero.title}<span class="text-zinc-300">{tAbout.hero.highlight}<span class="text-emerald-500">.</span></span>
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl font-medium text-zinc-400 mt-5 md:mt-6 tracking-tight max-w-2xl">
          {tAbout.hero.subtitle}
        </p>
      </div>
    </section>

    <section class="w-[90%] md:w-[95%] md:max-w-[72rem] mx-auto border-t border-zinc-200 py-16 md:py-28">
      <div class="max-w-5xl text-base sm:text-lg md:text-xl text-zinc-600 space-y-6 md:space-y-8 leading-relaxed font-medium">
        <p>
          {tAbout.story.part1} <strong class="text-zinc-900 font-bold text-emerald-900 bg-emerald-50 px-2 py-1">{tAbout.story.highlight}</strong>
        </p>
        <p>
          {tAbout.story.part2}
        </p>
      </div>
    </section>

    <section class="w-[90%] md:w-[95%] md:max-w-[72rem] mx-auto pb-16 md:pb-32">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
        <div class="border-t-2 border-zinc-200 hover:border-emerald-500 pt-6 md:pt-8 group transition-colors duration-500">
          <div class="text-4xl md:text-6xl font-extrabold text-zinc-100 mb-4 md:mb-6 group-hover:text-emerald-500 transition-colors duration-500 tracking-tighter">01</div>
          <h2 class="text-lg md:text-2xl font-bold text-zinc-900 mb-2 md:mb-3 pr-4 leading-tight">{tAbout.problems.p1.title}</h2>
          <p class="text-zinc-500 text-sm md:text-lg leading-relaxed">{tAbout.problems.p1.desc}</p>
        </div>
        <div class="border-t-2 border-zinc-200 hover:border-emerald-500 pt-6 md:pt-8 group transition-colors duration-500">
          <div class="text-4xl md:text-6xl font-extrabold text-zinc-100 mb-4 md:mb-6 group-hover:text-emerald-500 transition-colors duration-500 tracking-tighter">02</div>
          <h2 class="text-lg md:text-2xl font-bold text-zinc-900 mb-2 md:mb-3 pr-4 leading-tight">{tAbout.problems.p2.title}</h2>
          <p class="text-zinc-500 text-sm md:text-lg leading-relaxed">{tAbout.problems.p2.desc}</p>
        </div>
        <div class="border-t-2 border-zinc-200 hover:border-emerald-500 pt-6 md:pt-8 group transition-colors duration-500">
          <div class="text-4xl md:text-6xl font-extrabold text-zinc-100 mb-4 md:mb-6 group-hover:text-emerald-500 transition-colors duration-500 tracking-tighter">03</div>
          <h2 class="text-lg md:text-2xl font-bold text-zinc-900 mb-2 md:mb-3 pr-4 leading-tight">{tAbout.problems.p3.title}</h2>
          <p class="text-zinc-500 text-sm md:text-lg leading-relaxed">{tAbout.problems.p3.desc}</p>
        </div>
      </div>
      
      <div class="mt-16 md:mt-24 max-w-4xl text-lg sm:text-xl md:text-3xl font-medium text-zinc-900 leading-snug tracking-tight">
        {tAbout.solution.text} <span class="block mt-3 md:mt-4 text-emerald-600">{tAbout.solution.highlight}</span>
      </div>
    </section>

    <!-- ZAKTUALIZOWANA SEKCJA ZESPOŁU -->
    <section class="bg-zinc-50 py-16 md:py-32 border-y border-zinc-200">
      <div class="w-[90%] md:w-[95%] md:max-w-[72rem] mx-auto">
        <div class="mb-12 md:mb-28 max-w-4xl">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-zinc-900 tracking-tighter mb-4 md:mb-6 leading-[1.05]">
            {tAbout.team.title.replace('.', '')}<span class="text-emerald-500">.</span>
          </h2>
          <p class="text-base sm:text-lg md:text-xl text-zinc-500 leading-relaxed font-medium">
            {tAbout.team.desc}
          </p>
        </div>

        <div class="space-y-16 md:space-y-24">
          <!-- HUBERT -->
          <div class="flex flex-col md:flex-row gap-6 md:gap-16 items-start">
            <div class="w-full sm:w-[80%] mx-auto md:w-1/3 relative group shrink-0">
              <!-- Dekoracyjny offset (cień/blok z tyłu) -->
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-100 to-emerald-50 rounded-2xl translate-x-2 translate-y-2 md:translate-x-3 md:translate-y-3 group-hover:translate-x-3 group-hover:translate-y-3 md:group-hover:translate-x-4 md:group-hover:translate-y-4 transition-transform duration-700 ease-out z-0"></div>
              
              <!-- Główny kontener zdjęcia -->
              <div class="aspect-square md:aspect-[4/5] overflow-hidden bg-white rounded-2xl relative shadow-md ring-1 ring-black/5 group-hover:shadow-2xl group-hover:shadow-emerald-900/10 transition-all duration-700 z-10">
                <img 
                  src={hubertImg} 
                  alt="Hubert" 
                  loading="lazy"
                  width="400"
                  height="500"
                  decoding="async"
                  class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-all duration-700 ease-out"
                />
                <!-- Subtelny gradient na dole zdjęcia dodający głębi -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
              </div>
            </div>
            
            <div class="w-full md:w-2/3 md:pt-4 relative z-10">
              <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-zinc-900 mb-1 md:mb-2 tracking-tight">Hubert</h3>
              <p class="text-[10px] md:text-xs font-bold text-emerald-600 uppercase tracking-widest mb-4 md:mb-6">{tAbout.team.hubert.role}</p>
              <p class="text-zinc-500 leading-relaxed text-sm sm:text-base md:text-lg">
                {tAbout.team.hubert.bio}
              </p>
            </div>
          </div>

          <!-- MAREK -->
          <div class="flex flex-col md:flex-row-reverse gap-6 md:gap-16 items-start">
            <div class="w-full sm:w-[80%] mx-auto md:w-1/3 relative group shrink-0">
              <!-- Dekoracyjny offset w przeciwną stronę dla symetrii -->
              <div class="absolute inset-0 bg-gradient-to-bl from-emerald-100 to-emerald-50 rounded-2xl -translate-x-2 translate-y-2 md:-translate-x-3 md:translate-y-3 group-hover:-translate-x-3 group-hover:translate-y-3 md:group-hover:-translate-x-4 md:group-hover:translate-y-4 transition-transform duration-700 ease-out z-0"></div>
              
              <!-- Główny kontener zdjęcia -->
              <div class="aspect-square md:aspect-[4/5] overflow-hidden bg-white rounded-2xl relative shadow-md ring-1 ring-black/5 group-hover:shadow-2xl group-hover:shadow-emerald-900/10 transition-all duration-700 z-10">
                <img 
                  src={marekImg} 
                  alt="Marek" 
                  loading="lazy"
                  width="400"
                  height="500"
                  decoding="async"
                  class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-all duration-700 ease-out"
                />
                <!-- Subtelny gradient na dole zdjęcia dodający głębi -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
              </div>
            </div>
            
            <div class="w-full md:w-2/3 md:pt-4 md:text-right relative z-10">
              <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-zinc-900 mb-1 md:mb-2 tracking-tight">Marek</h3>
              <p class="text-[10px] md:text-xs font-bold text-emerald-600 uppercase tracking-widest mb-4 md:mb-6">{tAbout.team.marek.role}</p>
              <p class="text-zinc-500 leading-relaxed text-sm sm:text-base md:text-lg">
                {tAbout.team.marek.bio}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-zinc-900 text-zinc-400 py-16 md:py-32 flex justify-center w-full">
      <div class="w-[90%] md:w-[95%] md:max-w-[72rem] grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24">
        
        <div class="pr-0 md:pr-8">
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-white tracking-tighter mb-6 md:mb-8 leading-tight">
            {tAbout.philosophy.title1.replace('.', '')}<span class="text-emerald-500">.</span>
          </h2>
          <div class="space-y-4 md:space-y-6 text-base sm:text-lg md:text-xl leading-relaxed">
            <p>
              {tAbout.philosophy.p1}
            </p>
            <p>
              {tAbout.philosophy.p2}
            </p>
          </div>
        </div>

        <div class="md:border-l border-zinc-800 pt-8 md:pt-0 pl-0 md:pl-16 flex flex-col justify-center border-t md:border-t-0">
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-white tracking-tighter mb-6 md:mb-8 leading-tight">
            {tAbout.philosophy.title2.replace('.', '')}<span class="text-emerald-500">.</span>
          </h2>
          <div class="space-y-4 md:space-y-6 text-base sm:text-lg md:text-xl leading-relaxed">
            <p>
              {tAbout.philosophy.p3}
            </p>
            <p>
              {tAbout.philosophy.p4}
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="py-16 md:py-24 lg:py-32 w-[90%] md:w-[95%] md:max-w-[72rem] mx-auto">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-zinc-950 px-6 py-14 text-center shadow-2xl shadow-zinc-900/10 md:px-12 md:py-20">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.28),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.12),transparent_32%)]"></div>
        <div class="relative z-10 mx-auto max-w-3xl">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-5 tracking-tight">{tAbout.cta.title}</h2>
          <p class="text-base sm:text-lg text-zinc-300 max-w-2xl mx-auto leading-relaxed">{tAbout.cta.desc}</p>
          <a href="/register" class="mt-8 inline-flex items-center justify-center rounded-full bg-emerald-500 px-7 py-3.5 text-sm font-bold text-white shadow-xl shadow-emerald-500/20 transition-all hover:bg-emerald-400 hover:scale-[1.02] active:scale-95">
            {t.nav.startFree}
          </a>
        </div>
      </div>
    </section>

  </main>

</BaseLayout>
