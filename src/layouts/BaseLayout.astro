---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import CallbackWidget from "../components/CallbackWidget.astro";
import CookieConsent from "../components/CookieConsent.astro";
import type { Locale } from "../i18n/config";
import type { AlternateUrl } from "../utils/i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  slug?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  author?: string;
  noindex?: boolean;
  alternates?: AlternateUrl[];
  isLandingPage?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  callbackRevealSelector?: string;
  lazyChatWidget?: boolean;
  lazyAnalytics?: boolean;
}

const {
  title,
  description,
  lang,
  slug = "",
  image,
  imageAlt,
  type,
  publishedAt,
  modifiedAt,
  author,
  noindex = false,
  alternates,
  isLandingPage = false,
  hideHeader = false,
  hideFooter = false,
  callbackRevealSelector,
  lazyChatWidget = false,
  lazyAnalytics = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Chataptor" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      lang={lang}
      slug={slug}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedAt={publishedAt}
      modifiedAt={modifiedAt}
      author={author}
      noindex={noindex}
      alternates={alternates}
    />

    {/* GLOBALNE STYLE SKALOWANIA */}
    <style is:global>
      /* Default (Mobile): 15px base */
      html {
        font-size: 15px;
      }

      /* Desktop Fluid Scaling */
      @media (min-width: 1024px) {
        html {
          font-size: 11.5px;
        }
      }

      /* Large Screens */
      @media (min-width: 1536px) {
        html {
          font-size: 13px;
        }
      }

      html {
        transition: font-size 0.2s ease-out;
      }

      /* Custom Scrollbar */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 20px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background-color: rgba(0, 0, 0, 0.2);
      }

      ::selection {
        background-color: #d1fae5;
        color: #064e3b;
      }
    </style>

    <script is:inline>
      // Inicjalizacja Google Consent Mode v2 (Domyślnie blokuje cookies, pozwala na anonimowe pingi)
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function gtag() {
          dataLayer.push(arguments);
        };

      // Ustawienia początkowe - odrzucone
      window.gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
    </script>

    {
      !lazyAnalytics && (
        <script
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-1BV9YBEBDT"
          is:inline
        />
      )
    }
    <script is:inline define:vars={{ lazyAnalytics }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function gtag() {
          dataLayer.push(arguments);
        };

      if (lazyAnalytics) {
        (function () {
          var loaded = false;

          function loadGoogleTag() {
            if (loaded) return;
            loaded = true;

            var script = document.createElement("script");
            script.async = true;
            script.src =
              "https://www.googletagmanager.com/gtag/js?id=G-1BV9YBEBDT";
            document.head.appendChild(script);

            window.gtag("js", new Date());
            window.gtag("config", "G-1BV9YBEBDT");
          }

          function scheduleGoogleTag() {
            window.setTimeout(loadGoogleTag, 1400);
          }

          if (document.readyState === "complete") {
            scheduleGoogleTag();
          } else {
            window.addEventListener("load", scheduleGoogleTag, {
              once: true,
            });
          }
        })();
      } else {
        window.gtag("js", new Date());
        window.gtag("config", "G-1BV9YBEBDT");
      }
    </script>

    <script is:inline>
      // Minimalistyczna funkcja ładowania skryptów na podstawie zgody
      (function () {
        function getC() {
          try {
            return JSON.parse(localStorage.getItem("cookie_consent"));
          } catch (e) {
            return null;
          }
        }
        function loadAnalytics() {
          if (window.analyticsLoaded) return;
          window.analyticsLoaded = true;

          // Clarity w pełni zablokowane bez zgody
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "vypq0o7uwg");
        }
        function applyC(c) {
          if (!c) return;

          // Aktualizacja Consent Mode GA4
          if (window.gtag) {
            window.gtag("consent", "update", {
              analytics_storage: c.analytics ? "granted" : "denied",
              ad_storage: c.marketing ? "granted" : "denied",
              ad_user_data: c.marketing ? "granted" : "denied",
              ad_personalization: c.marketing ? "granted" : "denied",
            });
          }

          if (c.analytics) loadAnalytics(); // To załaduje tylko Clarity po udzieleniu zgody
        }
        applyC(getC());
        window.addEventListener("cookie_consent_updated", function (e) {
          applyC(e.detail);
        });
      })();
    </script>
  </head>
  <body
    class="bg-white text-zinc-900 font-sans overflow-x-hidden flex flex-col min-h-screen"
  >
    {!hideHeader && <Header lang={lang} isLandingPage={isLandingPage} />}

    <div class="flex-1 w-full">
      <slot />
      <CallbackWidget revealOnSelector={callbackRevealSelector} />
    </div>

    {!hideFooter && <Footer lang={lang} />}

    <CookieConsent lang={lang} />

    {
      !lazyChatWidget && (
        <script
          is:inline
          src="https://chataptor.com/widget/quantumchat-widget.umd.js"
          data-api-url="https://chataptor.com"
          data-site-id="chataptor-1769604218"
          data-widget-key="cGtflAUCFCQ8y72h6ecYf9nKRLxejR-Y"
          data-welcome-message="Hello! How can I help you today?"
          data-header-title="Customer Support"
          data-input-placeholder="Type your message..."
          data-theme="light"
          data-position="bottom-right"
          data-primary-color="#18181B"
          data-translation-enabled="true"
          data-debug="false"
          defer
        />
      )
    }
    <script is:inline define:vars={{ lazyChatWidget }}>
      if (lazyChatWidget) {
        (function () {
          var loaded = false;

          function loadChatWidget() {
            if (loaded) return;
            loaded = true;

            var script = document.createElement("script");
            script.src =
              "https://chataptor.com/widget/quantumchat-widget.umd.js";
            script.defer = true;
            script.dataset.apiUrl = "https://chataptor.com";
            script.dataset.siteId = "chataptor-1769604218";
            script.dataset.widgetKey = "cGtflAUCFCQ8y72h6ecYf9nKRLxejR-Y";
            script.dataset.welcomeMessage = "Hello! How can I help you today?";
            script.dataset.headerTitle = "Customer Support";
            script.dataset.inputPlaceholder = "Type your message...";
            script.dataset.theme = "light";
            script.dataset.position = "bottom-right";
            script.dataset.primaryColor = "#18181B";
            script.dataset.translationEnabled = "true";
            script.dataset.debug = "false";
            document.body.appendChild(script);
          }

          function scheduleChatWidget() {
            window.setTimeout(loadChatWidget, 6500);
          }

          if (document.readyState === "complete") {
            scheduleChatWidget();
          } else {
            window.addEventListener("load", scheduleChatWidget, {
              once: true,
            });
          }
        })();
      }
    </script>
  </body>
</html>
